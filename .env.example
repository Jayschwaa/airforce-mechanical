# Contact form email is sent through Resend (https://resend.com).
# Without a key the form falls back to opening a pre-filled email.
RESEND_API_KEY=
# Optional. Sender address; its domain must be verified in Resend.
# CONTACT_FROM_EMAIL="Air Force Mechanical Website <website@airforceteam.com>"
# Optional. Comma-separated recipients. Defaults to the address in src/lib/site.ts.
# CONTACT_TO_EMAIL=
